datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// Models use String enums validated in application code
// This avoids Prisma schema validation issues with Enum types

model Merchant {
  id              String   @id @default(cuid())
  name            String
  currency        String   @default("INR")
  timezone        String   @default("Asia/Kolkata")
  retentionPolicy Json     @default("{\"transactionsMonths\":36,\"auditLogsMonths\":12,\"appLogsDays\":30,\"notificationsDays\":90,\"tempJobsDays\":7}")
  settings        Json     @default("{}")
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  // Real relational mappings
  users           User[]
  providerConnections ProviderConnection[]
  transactions    Transaction[]
  revenueCases    RevenueCase[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  webhookEvents   WebhookEvent[]
  refunds         Refund[]
  checkoutSessions CheckoutSession[]
  invoices        Invoice[]
  paymentPlans    PaymentPlan[]
  promisesToPay   PromiseToPay[]
  retrySchedules  RetrySchedule[]
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?
  role          String
  status        String   @default("active")
  createdAt     DateTime
  updatedAt     DateTime @updatedAt
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  merchantId    String?
  passwordResetTokens PasswordResetToken[]
}

// Single-use, time-limited password reset tokens (stored hashed).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Durable webhook ingestion log - owns the idempotency state machine.
// States: RECEIVED -> PROCESSING -> PROCESSED | FAILED
model WebhookEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  provider        String    @default("razorpay")
  eventType       String
  payloadHash     String
  status          String    @default("RECEIVED")
  summary         Json?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  retryCount      Int       @default(0)
  error           String?
  merchant        Merchant? @relation(fields: [merchantId], references: [id])
  merchantId      String?
  transaction     Transaction?

  @@index([status])
}

model ProviderConnection {
  id                String   @id @default(cuid())
  merchantId        String
  provider          String   // "razorpay"
  credentialsRef    String?  // Reference to encrypted secret store
  keyId             String?  // Razorpay Key ID (not secret)
  keySecretEncrypted String? // AES-256-GCM encrypted key_secret (never returned to client)
  lastSyncAt        DateTime?
  status            String   @default("active")
  mode              String?  // "test_demo" (simulated) | "live"
  displayName       String?  // Masked key id, e.g. rzp_test_****1234
  webhookSecret     String?  // Legacy plaintext webhook secret (kept for backward compat)
  webhookSecretEncrypted String? // AES-256-GCM encrypted webhook secret (never returned to client)
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
  merchant          Merchant @relation(fields: [merchantId], references: [id])
}

model Transaction {
  id                    String           @id @default(cuid())
  providerTransactionId String           @unique
  merchantId            String
  amount                Int              // In paise/cents
  currency              String           @default("INR")
  status                String
  paymentMethod         String
  paymentMethodDetails  Json?            // Safe metadata only
  failureCode           String?
  failureCategory       String?
  failureMessage        String?
  occurredAt            DateTime
  rawEventRef           String?          // Reference to raw webhook payload (minimal)
  createdAt             DateTime
  webhookEvent          WebhookEvent?    @relation(fields: [webhookEventId], references: [id])
  webhookEventId        String?          @unique
  merchant              Merchant         @relation(fields: [merchantId], references: [id])
  revenueCases          RevenueCase[]
}

model RevenueCase {
  id              String       @id @default(cuid())
  ref             String?      @unique // Human-friendly case ref, e.g. RP-1001
  transactionId   String       @unique
  caseType        String       // "payment_degradation" | "subscription_recovery"
  amountAtRisk    Int          // In paise
  diagnosis       Json?        // Structured diagnosis
  priority        Int          // Computed priority score
  status          String     // Case status string
  merchantId      String
  currentActionId String?
  attemptCount    Int          @default(0)
  lastAttemptAt   DateTime?
  stoppedReason   String?
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  merchant        Merchant     @relation(fields: [merchantId], references: [id])
  refunds         Refund[]
}

model Prediction {
  id                String   @id @default(cuid())
  caseId            String   @unique
  modelVersion      String
  probability       Float    // 0-1
  expectedValue     Int      // In paise
  confidence        Float?   // Calibration info
  featureSnapshot   Json     // Features used for prediction
  createdAt         DateTime
}

model RecoveryAction {
  id                String      @id @default(cuid())
  caseId            String
  actionType        String     // Action type string
  policySnapshot    Json        // Policy at time of decision
  expectedCost      Int         // In paise
  expectedNetRecovery Int       // In paise
  approvalStatus    String     // "not_required" | "pending" | "approved" | "rejected"
  approverId        String?
  approvedAt        DateTime?
  executionStatus   String     // Action status string
  idempotencyKey    String      @unique
  providerActionId  String?     // Razorpay retry ID, etc.
  executedAt        DateTime?
  completedAt       DateTime?
  error             String?
  outcomeId         String?  @unique
  outcome           Outcome?
  createdAt         DateTime @default(now())
  @@index([caseId])
  @@index([executionStatus])
  @@index([idempotencyKey])
}

model Outcome {
  id                String   @id @default(cuid())
  actionId          String   @unique
  action            RecoveryAction @relation(fields: [actionId], references: [id])
  recoveredAmount   Int      // In paise
  result            String   // Outcome result string
  recoveryTimestamp DateTime
  measuredCost      Int      // In paise
  notes             String?
  verifiedAt        DateTime?
  verificationRef   String?  // Webhook/event reference
  createdAt         DateTime @default(now())
}

model Refund {
  id                String   @id @default(cuid())
  caseId            String
  transactionId     String
  merchantId        String
  amount            Int      // In paise — refund amount requested
  status            String   // "pending" | "initiated" | "processed" | "failed"
  providerRefundId  String?  // Razorpay refund ID, if initiated
  reason            String?  // Why refund is being requested
  initiatedBy       String?  // userId or "system"
  initiatedAt       DateTime?
  completedAt       DateTime?
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  case              RevenueCase @relation(fields: [caseId], references: [id])
  merchant          Merchant    @relation(fields: [merchantId], references: [id])
  @@index([caseId])
  @@index([transactionId])
}

model AuditLog {
  id            String   @id @default(cuid())
  merchantId    String
  actorType     String   // "user" | "agent" | "system"
  actorId       String
  action        String
  entityType    String
  entityId      String
  reason        String
  evidence      Json?    // References to predictions, policies, etc.
  policyResult  Json?    // Policy evaluation result
  beforeState   Json?
  afterState    Json?
  createdAt     DateTime
  merchant      Merchant @relation(fields: [merchantId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  merchantId  String
  type        String   // Notification type string
  severity    String   // Notification severity string
  title       String
  message     String
  entityType  String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model EvaluationRun {
  id            String   @id @default(cuid())
  datasetVersion String
  modelVersion   String
  metrics        Json     // Precision, recall, F1, ROC-AUC, calibration, business metrics
  baselineMetrics Json?  // Comparison baselines
  notes          String?
  createdAt     DateTime
}

// ── Checkout Abandonment Recovery ───────────────────────────────────────────

model CheckoutSession {
  id                String   @id @default(cuid())
  sessionId         String   @unique // Provider checkout/order ID
  merchantId        String
  customerEmail     String?
  customerPhone     String?
  amount            Int      // In paise
  currency          String   @default("INR")
  items             Json?    // Cart contents snapshot
  status            String   // "abandoned" | "recovery_sent" | "recovered" | "expired"
  abandonmentReason String?  // "payment_failed" | "timeout" | "user_exit" | "network_error"
  recoveryChannel   String?  // "email" | "sms" | "whatsapp" | "push"
  incentiveType     String?  // "discount_pct" | "flat_discount" | "free_shipping" | "grace_period"
  incentiveValue    Json?    // { discountPct: 10 } or { flatDiscount: 5000 } etc
  recoveredAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  @@index([merchantId, status])
  @@index([sessionId])
}

// ── B2B Receivables Chaser ──────────────────────────────────────────────────

model Invoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  merchantId        String
  customerName      String
  customerEmail     String?
  customerPhone     String?
  amount            Int      // In paise — total invoice amount
  currency          String   @default("INR")
  dueDate           DateTime
  issuedAt          DateTime
  status            String   // "pending" | "overdue" | "partially_paid" | "paid" | "written_off"
  amountPaid        Int      @default(0) // In paise
  overdueDays       Int      @default(0)
  agingBucket       String?  // "0-30" | "31-60" | "61-90" | "90+"
  lastChasedAt      DateTime?
  chaseCount        Int      @default(0)
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  promises          PromiseToPay[]
  @@index([merchantId, status])
  @@index([merchantId, overdueDays])
}

model PaymentPlan {
  id              String   @id @default(cuid())
  invoiceId       String   @unique
  merchantId      String
  totalAmount     Int      // In paise
  installments    Json     // [{ amount: 50000, dueDate: "2026-09-01", status: "pending" }]
  currentInstallment Int @default(0)
  status          String   // "active" | "completed" | "defaulted" | "cancelled"
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  merchant        Merchant @relation(fields: [merchantId], references: [id])
}

// ── Promise-to-Pay Tracker ──────────────────────────────────────────────────

model PromiseToPay {
  id              String   @id @default(cuid())
  invoiceId       String?
  merchantId      String
  customerEmail   String?
  customerPhone   String?
  promisedAmount  Int      // In paise
  promisedDate    DateTime
  status          String   // "pending" | "kept" | "broken" | "extended"
  channel         String?  // "phone" | "email" | "sms" | "whatsapp" | "chat"
  agentNotes      String?
  escalationLevel Int      @default(0) // 0=initial, 1=first reminder, 2=final, 3=escalated
  extendedDate    DateTime?
  keptAt          DateTime?
  brokenAt        DateTime?
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  @@index([merchantId, status])
  @@index([invoiceId])
  @@index([promisedDate])
}

// ── Mandate Retry Schedule ──────────────────────────────────────────────────

model RetrySchedule {
  id              String   @id @default(cuid())
  caseId          String   @unique
  merchantId      String
  failureCategory String   // Original failure category
  retryWindow     Json     // { baseHours: 24, maxRetries: 3, backoff: "exponential" }
  currentRetry    Int      @default(0)
  maxRetries      Int      @default(3)
  nextRetryAt     DateTime
  lastRetryAt     DateTime?
  status          String   // "scheduled" | "executing" | "completed" | "exhausted" | "cancelled"
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  @@index([merchantId, status])
  @@index([nextRetryAt])
}