{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@rp/database": ["../../packages/database/index.ts"],
      "@rp/observability": ["../../packages/observability/index.ts"],
      "@rp/providers": ["../../packages/providers/index.ts"],
      "@rp/razorpay": ["../../packages/razorpay/src/index.ts"],
      "@rp/domain": ["../../packages/domain/src/index.ts"],
      "@rp/policies": ["../../packages/policies/src/index.ts"],
      "@rp/auth": ["../../packages/auth/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}