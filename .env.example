# RevenuePulse environment template.
# Copy to .env (root) and/or apps/web/.env and fill in real values.

# --- Required in production (server refuses to start without them) ---
# JWT signing + provider-secret encryption key. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# DATABASE_URL=postgresql://user:password@host:5432/revenuepulse?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/revenuepulse?schema=public"
# ML prediction service base URL
ML_SERVICE_URL=http://127.0.0.1:8001

# --- Auth / mode ---
# NextAuth.js; set NEXTAUTH_URL to your deployment origin in production
# NEXTAUTH_URL=http://localhost:3000

# Razorpay operating mode: demo (unsigned local events) | live (strict HMAC)
RAZORPAY_MODE=demo
# Required when RAZORPAY_MODE=live (fallback: per-merchant stored secrets)
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_KEY / RAZORPAY_API_SECRET are stored encrypted per merchant
# via the integrations UI instead of env vars.

# --- Feature flags (all default off/safe) ---
# Route pipeline jobs through pg-boss worker instead of inline execution (1 = on)
RP_USE_QUEUE=
# Allow unauthenticated requests to fall back to the demo tenant.
# NEVER enable in production unless running a public demo.
RP_DEMO_FALLBACK=
# Allow labeled heuristic fallback when ML service is unreachable (dev only)
RP_ML_FALLBACK=
# Live-outcome verification poll interval in seconds (default 300)
RP_VERIFY_POLL_SECONDS=

# --- Observability ---
# debug | info | warn | error (default info)
LOG_LEVEL=info
