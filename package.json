{
  "name": "revenuepulse",
  "version": "1.0.0",
  "description": "RevenuePulse - AI Revenue Recovery Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "turbo run dev --scope=web",
    "build": "turbo run build --scope=web",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate make init && prisma migrate deploy"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.2.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "prisma": "^7.9.1",
    "turbo": "^1.13.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1"
  }
}
