{
  "name": "revenuepulse",
  "version": "1.0.0",
  "description": "RevenuePulse - AI Revenue Recovery Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npx tsx scripts/test-unit.ts",
    "test:integration": "npx tsx scripts/test-integration.ts",
    "worker": "npx tsx apps/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "turbo run dev --scope=web",
    "build": "turbo run build --scope=web",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "ml:train": "python services/ml/data/generate_synthetic.py && python services/ml/train_baseline.py",
    "experiment": "tsx scripts/batch-experiment.ts 100",
    "experiment:500": "tsx scripts/batch-experiment.ts 500",
    "seed": "tsx scripts/seed-demo-data.ts",
    "demo": "prisma db push && prisma generate && tsx scripts/seed-demo-data.ts && tsx scripts/batch-experiment.ts 100",
    "demo:500": "prisma db push && prisma generate && tsx scripts/seed-demo-data.ts && tsx scripts/batch-experiment.ts 500"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "turbo": "^1.13.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1"
  }
}
